default_platform(:ios)

platform :ios do
  desc "Create or update only TherDia App Store profile, preserving existing team certificates"
  lane :prepare_signing do
    setup_ci if ENV['CI']

    app_store_connect_api_key(
      key_id: ENV.fetch("FASTLANE_KEY_ID"),
      issuer_id: ENV.fetch("FASTLANE_ISSUER_ID"),
      key_content: ENV.fetch("FASTLANE_KEY"),
      is_key_content_base64: false
    )

    match(
      type: "appstore",
      readonly: false,
      force: false,
      app_identifier: [ENV.fetch("APP_IDENTIFIER", "de.therdia.app")],
      git_basic_authorization: Base64.strict_encode64("#{ENV.fetch('GITHUB_REPOSITORY_OWNER')}:#{ENV.fetch('GH_PAT')}")
    )
  end

  desc "Upload an already signed TherDia IPA to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("FASTLANE_KEY_ID"),
      issuer_id: ENV.fetch("FASTLANE_ISSUER_ID"),
      key_content: ENV.fetch("FASTLANE_KEY"),
      is_key_content_base64: false
    )
    upload_to_testflight(
      api_key: api_key,
      ipa: ENV.fetch("IPA_PATH", "TherDia.ipa"),
      app_identifier: ENV.fetch("APP_IDENTIFIER", "de.therdia.app"),
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
