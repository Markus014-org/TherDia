default_platform(:ios)

platform :ios do
  desc "Upload the signed TherDia IPA to Apple TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_filepath: ENV.fetch("APPSTORE_PRIVATE_KEY_PATH"),
      duration: 1200
    )
    upload_to_testflight(
      api_key: api_key,
      ipa: ENV.fetch("IPA_PATH"),
      app_identifier: ENV.fetch("BUNDLE_ID"),
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
